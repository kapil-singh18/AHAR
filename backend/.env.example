PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/smart_kitchen
# Optional: use standard (non-SRV) Atlas URI if SRV DNS lookup fails on your network.
# MONGODB_URI_FALLBACK=mongodb://<host1>:27017,<host2>:27017,<host3>:27017/<db>?replicaSet=<rs>&ssl=true&authSource=admin&retryWrites=true&w=majority
ML_DEMAND_URL=http://localhost:5001/predict-demand
ML_WASTE_URL=http://localhost:5001/predict
ML_RECOMMENDER_URL=http://localhost:5001/recommend
ML_TIMEOUT_MS=5000
ML_EXPIRY_URL=http://localhost:5002/detect
CORS_ORIGIN=http://localhost:5173,https://ahar-rho.vercel.app
NODE_ENV=development
DB_RETRY_MS=10000
JSON_BODY_LIMIT=1mb
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
REQUEST_TIMEOUT_MS=20000

JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
REFRESH_COOKIE_NAME=ahar_refresh
COOKIE_SAMESITE=lax
DEFAULT_KITCHEN_ID=kitchen-nyc-001
